{
  "apiVersion": "memmy/v1",
  "id": "teach-mode",
  "name": "Teach Mode",
  "version": "0.4.1",
  "description": "在当前对话中录制已授权的电脑操作事件，结束后按需调用 Skill Creator 生成可复用技能。",
  "platforms": [
    "win32",
    "darwin"
  ],
  "minimumHostVersion": "1.2.4",
  "installMode": "manual",
  "updateMode": "automatic",
  "runtime": {
    "adapter": "mcp",
    "config": {
      "transport": "stdio",
      "command": "dist/index.js",
      "interpreter": "node",
      "sandbox": "none",
      "shutdownTool": "memmy_shutdown",
      "timeoutMs": 300000
    }
  },
  "permissions": [
    {
      "type": "host-service",
      "services": [
        "native-execution",
        "plugin-data",
        "artifact-host",
        "plugin-context",
        "collector",
        "recording",
        "window-focus",
        "skills",
        "event-sessions"
      ],
      "description": "按你的开始指令订阅 Computer History 已授权的事件，在本机保存录制片段和生成技能。结束录制不会自动生成或执行技能。旧版教学技能保留原有执行权限。"
    }
  ],
  "configSchema": {
    "type": "object",
    "properties": {
      "outputDirectory": {
        "type": "string",
        "minLength": 1
      }
    },
    "additionalProperties": false
  },
  "capabilities": [
    {
      "id": "record_and_replay",
      "name": "Record and Replay",
      "description": "在当前对话开始、查询、结束或取消事件录制。仅唤起不开始；用户明确要求开始并说明采集范围后用 consent=true。复用已授权 Computer History 事件，任意应用，不要求视频。结束后等待用户另行请求生成技能。 浏览器教学先用 browser-options 查询连接，再用 browser 创建沿用日常登录态的新教学窗口；仅该窗口及其弹窗纳入，原有窗口不纳入。",
      "execution": "request",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "enum": [
              "status",
              "list",
              "start",
              "stop",
              "cancel",
              "read",
              "browser-options"
            ]
          },
          "session_id": {
            "type": "string",
            "format": "uuid"
          },
          "goal": {
            "type": "string",
            "maxLength": 2000
          },
          "consent": {
            "type": "boolean"
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "browser": {
            "type": "object",
            "description": "仅在用户同意录制浏览器教学窗口时传入；省略则保持原有桌面事件录制。",
            "properties": {
              "name": {
                "enum": [
                  "chrome",
                  "edge"
                ]
              },
              "connection_id": {
                "type": "string",
                "description": "多个浏览器资料连接时，使用用户在对话中选择的 browser-options 连接。"
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object"
      }
    },
    {
      "id": "create_skill",
      "name": "Skill Creator",
      "description": "仅在用户要求生成 skill 时使用。prepare 选择已结束片段，读取 Host Skill Creator 指令及事件页；信息不足先在对话询问，再 save 提交结构化草稿。成功只表示生成、校验和保存，不表示执行成功。",
      "execution": "request",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "enum": [
              "prepare",
              "save"
            ]
          },
          "session_id": {
            "type": "string",
            "format": "uuid"
          },
          "events_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "generate": {
            "type": "boolean"
          },
          "draft": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "maxLength": 64
              },
              "description": {
                "type": "string",
                "minLength": 10
              },
              "goal": {
                "type": "string",
                "minLength": 1
              },
              "prerequisites": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "parameters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1
                    },
                    "example": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "name",
                    "description"
                  ],
                  "additionalProperties": false
                }
              },
              "steps": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "instruction": {
                      "type": "string",
                      "minLength": 1
                    },
                    "evidenceIndexes": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "confirmedByUser": {
                      "type": "boolean"
                    },
                    "evidenceStatus": {
                      "enum": [
                        "observed",
                        "context-only",
                        "user-specified",
                        "unverified"
                      ]
                    },
                    "controlType": {
                      "enum": [
                        "text",
                        "date-time",
                        "select",
                        "other"
                      ]
                    }
                  },
                  "required": [
                    "instruction",
                    "evidenceIndexes"
                  ],
                  "additionalProperties": false
                }
              },
              "tools": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "completionChecks": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "limitations": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "teachingGaps": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "properties": {
                    "description": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    "stepIndexes": {
                      "type": "array",
                      "maxItems": 100,
                      "items": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "reason": {
                      "enum": [
                        "action-not-observed",
                        "parameter-not-observed",
                        "result-not-observed",
                        "unsupported-control",
                        "capture-gap",
                        "unverified-step"
                      ]
                    },
                    "resolution": {
                      "enum": [
                        "needs-demonstration",
                        "user-specified",
                        "needs-validation"
                      ]
                    },
                    "nextAction": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    }
                  },
                  "required": [
                    "description",
                    "stepIndexes",
                    "reason",
                    "resolution",
                    "nextAction"
                  ],
                  "additionalProperties": false
                }
              },
              "executionMode": {
                "type": "string",
                "enum": [
                  "agent-tools",
                  "desktop"
                ],
                "description": "Use desktop when live native application UI is part of the workflow; declare managed Computer Use tools. exec is not a UI-input fallback."
              }
            },
            "required": [
              "name",
              "description",
              "goal",
              "prerequisites",
              "parameters",
              "steps",
              "tools",
              "completionChecks",
              "limitations"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object"
      }
    },
    {
      "id": "teach_session",
      "name": "运行旧版教学技能",
      "description": "仅 Windows：兼容已保存的 0.1 版网页到记事本技能；只在用户明确要求执行此类旧技能时使用。macOS 请使用对话式 Record and Replay 与 Skill Creator。",
      "execution": "job",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "enum": [
              "list",
              "get",
              "run",
              "cancel"
            ]
          },
          "session_id": {
            "type": "string",
            "format": "uuid"
          },
          "plan_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "consent": {
            "type": "boolean"
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object"
      }
    }
  ],
  "skills": [
    {
      "id": "record-and-replay",
      "name": "Record and Replay",
      "description": "在对话中录制、查看、结束或取消接下来的电脑操作；复用 Computer History 事件，不限制应用组合。",
      "entry": "skills/record-and-replay/SKILL.md"
    },
    {
      "id": "teach-skill-creator",
      "name": "Skill Creator",
      "description": "把用户指定的刚才录制操作生成可复用 skill；使用 Host Skill Creator 并校验事件、参数、工具和保存结果。",
      "entry": "skills/teach-skill-creator/SKILL.md"
    },
    {
      "id": "teach-mode",
      "name": "Teach Mode",
      "description": "兼容旧版教学技能，或在对话中使用 Record and Replay 与 Skill Creator。",
      "entry": "skills/teach-mode/SKILL.md"
    }
  ],
  "commands": [
    {
      "command": "/teach",
      "name": "Record and Replay",
      "description": "在当前对话中说明录制流程，等待开始指令",
      "capabilityId": "record_and_replay",
      "agentSkillId": "record-and-replay",
      "topbar": true,
      "icon": "activity"
    },
    {
      "command": "/teach-skill",
      "name": "Skill Creator",
      "description": "根据用户选择的录制片段生成 skill",
      "capabilityId": "create_skill",
      "agentSkillId": "teach-skill-creator",
      "icon": "sparkles"
    }
  ],
  "conversation": {
    "recordingCapabilityId": "record_and_replay",
    "skillCapabilityId": "create_skill",
    "recordingSkillId": "record-and-replay",
    "creatorSkillId": "teach-skill-creator"
  },
  "requiredHostCapabilities": [
    "memmy.mcp-native/v1",
    "memmy.host-service/v1",
    "memmy.event-sessions/v1",
    "memmy.generated-skills/v1",
    "memmy.conversation/v1",
    "memmy.event-checkpoints/v1"
  ],
  "rules": {
    "distribution": "public",
    "installation": "manual",
    "requiresLogin": false,
    "unavailableVisibility": "visible",
    "autoUpdate": true,
    "recommendsOfficialModel": false
  }
}
