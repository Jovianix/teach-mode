{
  "apiVersion": "memmy/v1",
  "id": "teach-mode",
  "name": "Teach Mode",
  "version": "0.5.0",
  "description": "演示电脑操作，在对话里说“录制完成”即可将示范整理为可复用技能。",
  "platforms": [
    "win32",
    "darwin"
  ],
  "minimumHostVersion": "1.2.4",
  "installMode": "manual",
  "updateMode": "automatic",
  "runtime": {
    "adapter": "mcp",
    "config": {
      "transport": "stdio",
      "command": "dist/index.js",
      "interpreter": "node",
      "sandbox": "none",
      "shutdownTool": "memmy_shutdown",
      "timeoutMs": 300000
    }
  },
  "permissions": [
    {
      "type": "host-service",
      "services": [
        "native-execution",
        "plugin-data",
        "artifact-host",
        "plugin-context",
        "skills",
        "event-sessions"
      ],
      "description": "确认后录制已授权的电脑操作，原始记录保存在本机。生成技能时由当前模型读取相关操作。"
    }
  ],
  "capabilities": [
    {
      "id": "record_and_replay",
      "name": "Record and Replay",
      "description": "用户准备好时调用 start，App 弹窗确认后通过 Computer History 开始录制，最长 30 分钟。不要检查浏览器标签或等待扩展。浮窗停止只保留片段；聊天中说录制完成时停止当前录制并交给 Skill Creator。丢弃后结束。",
      "execution": "request",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "enum": [
              "status",
              "list",
              "start",
              "stop",
              "cancel",
              "read"
            ]
          },
          "session_id": {
            "type": "string",
            "format": "uuid"
          },
          "goal": {
            "type": "string",
            "maxLength": 2000
          },
          "consent": {
            "type": "boolean"
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "view": {
            "type": "string",
            "enum": [
              "raw",
              "teaching"
            ],
            "description": "read 的证据视图。默认 raw 保持原始事件；teaching 提供有界精简页，保留原事件索引、脱敏和覆盖限制。"
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object"
      }
    },
    {
      "id": "create_skill",
      "name": "Skill Creator",
      "description": "用户在聊天中说录制完成，或要求创建技能时调用。prepare 取得录制证据及 Host Skill Creator 指令；目标明确时直接生成并 save，只在影响可复用流程时澄清。",
      "execution": "request",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "enum": [
              "prepare",
              "save"
            ],
            "description": "prepare 获取证据和 saveArguments。save 使用返回的参数，并附上 draft。"
          },
          "session_id": {
            "type": "string",
            "format": "uuid"
          },
          "events_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "generate": {
            "type": "boolean",
            "enum": [
              true
            ],
            "description": "兼容旧调用。action=save 已表示保存，无需再传此字段。"
          },
          "draft": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "maxLength": 64,
                "description": "1–64 个小写英文字母、数字或用单个连字符分隔的词，例如 open-folder。"
              },
              "description": {
                "type": "string",
                "minLength": 10,
                "maxLength": 1000,
                "description": "提供完整描述，避免 TODO、fill me in、尖括号等占位符。"
              },
              "goal": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "prerequisites": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "maxItems": 30
              },
              "parameters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                      "maxLength": 64,
                      "description": "使用与技能名相同的格式，例如 folder-name。"
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1
                    },
                    "example": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "name",
                    "description"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 30
              },
              "steps": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "instruction": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4000,
                      "description": "标记为 observed 时，原样使用所引用事件的 recordedAction。"
                    },
                    "evidenceIndexes": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "maxItems": 100
                    },
                    "confirmedByUser": {
                      "type": "boolean"
                    },
                    "evidenceStatus": {
                      "enum": [
                        "observed",
                        "context-only",
                        "user-specified",
                        "unverified"
                      ]
                    },
                    "controlType": {
                      "enum": [
                        "text",
                        "date-time",
                        "select",
                        "other"
                      ]
                    },
                    "replayInstruction": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4000,
                      "description": "建议的可复用执行方式，可包含任务参数。它与录制实际观察到的动作分开显示。"
                    }
                  },
                  "required": [
                    "instruction",
                    "evidenceIndexes"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 100
              },
              "tools": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]{1,128}$"
                },
                "maxItems": 30
              },
              "completionChecks": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "maxItems": 30
              },
              "limitations": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "maxItems": 30
              },
              "teachingGaps": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "properties": {
                    "description": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    "stepIndexes": {
                      "type": "array",
                      "maxItems": 100,
                      "items": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "reason": {
                      "enum": [
                        "action-not-observed",
                        "parameter-not-observed",
                        "result-not-observed",
                        "unsupported-control",
                        "capture-gap",
                        "unverified-step"
                      ]
                    },
                    "resolution": {
                      "enum": [
                        "needs-demonstration",
                        "user-specified",
                        "needs-validation"
                      ]
                    },
                    "nextAction": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    }
                  },
                  "required": [
                    "description",
                    "stepIndexes",
                    "reason",
                    "resolution",
                    "nextAction"
                  ],
                  "additionalProperties": false
                }
              },
              "executionMode": {
                "type": "string",
                "enum": [
                  "agent-tools",
                  "desktop"
                ],
                "description": "Use desktop when live native application UI is part of the workflow; declare managed Computer Use tools. exec is not a UI-input fallback."
              }
            },
            "required": [
              "name",
              "description",
              "goal",
              "prerequisites",
              "parameters",
              "steps",
              "tools",
              "completionChecks",
              "limitations"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false,
        "dependencies": {
          "action": {
            "if": {
              "properties": {
                "action": {
                  "const": "save"
                }
              }
            },
            "then": {
              "required": [
                "session_id",
                "events_sha256",
                "draft"
              ]
            },
            "else": {
              "properties": {
                "events_sha256": false,
                "draft": false,
                "generate": false
              }
            }
          }
        }
      },
      "outputSchema": {
        "type": "object"
      }
    }
  ],
  "skills": [
    {
      "id": "record-and-replay",
      "name": "Record and Replay",
      "description": "在对话中录制、查看、结束或取消接下来的电脑操作；复用 Computer History 事件，不限制应用组合。",
      "entry": "skills/record-and-replay/SKILL.md"
    },
    {
      "id": "teach-skill-creator",
      "name": "Skill Creator",
      "description": "把用户指定的刚才录制操作生成可复用 skill；使用 Host Skill Creator 并校验事件、参数、工具和保存结果。",
      "entry": "skills/teach-skill-creator/SKILL.md"
    }
  ],
  "commands": [
    {
      "command": "/teach",
      "name": "Record and Replay",
      "description": "在当前对话中说明录制流程，等待开始指令",
      "capabilityId": "record_and_replay",
      "agentSkillId": "record-and-replay",
      "topbar": true,
      "icon": "activity"
    },
    {
      "command": "/teach-skill",
      "name": "Skill Creator",
      "description": "根据用户选择的录制片段生成 skill",
      "capabilityId": "create_skill",
      "agentSkillId": "teach-skill-creator",
      "icon": "sparkles"
    }
  ],
  "conversation": {
    "recordingCapabilityId": "record_and_replay",
    "skillCapabilityId": "create_skill",
    "recordingSkillId": "record-and-replay",
    "creatorSkillId": "teach-skill-creator",
    "recordingControls": "record-and-replay"
  },
  "requiredHostCapabilities": [
    "memmy.mcp-native/v1",
    "memmy.host-service/v1",
    "memmy.event-sessions/v1",
    "memmy.generated-skills/v1",
    "memmy.conversation/v1",
    "memmy.event-checkpoints/v1",
    "memmy.recording-controls/v1"
  ],
  "rules": {
    "distribution": "public",
    "installation": "manual",
    "requiresLogin": false,
    "unavailableVisibility": "visible",
    "autoUpdate": true,
    "recommendsOfficialModel": false
  }
}
